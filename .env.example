# SunCity Environment Variables

# ===========================================
# Database (Supabase)
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# ===========================================
# Blockchain
# ===========================================
# RPC URLs (optional - uses public RPCs by default)
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Contract Addresses (update after deployment)
NEXT_PUBLIC_SOLAR_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_REWARDS_POOL_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# ===========================================
# WalletConnect (optional for additional wallets)
# ===========================================
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id

# ===========================================
# Environment
# ===========================================
NODE_ENV=development
